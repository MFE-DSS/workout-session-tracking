{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:auren:proposed:muscle-observed-load:1.0.0",
  "$comment": "DOCUMENTARY PROPOSED SCHEMA. NOT SERVED. Requires cross-field validation in WIRE_CONTRACT; byte/time/resource caps independent. No runtime code generated.",
  "oneOf": [
    {
      "$ref": "#/$defs/read_response"
    },
    {
      "$ref": "#/$defs/error_response"
    }
  ],
  "$defs": {
    "reasons": {
      "type": "array",
      "maxItems": 28,
      "items": {
        "type": "string",
        "enum": [
          "SCAN_TRUNCATED",
          "GRAPH_TRUNCATED",
          "RECEIPT_CHAIN_TRUNCATED",
          "NULL_EVENT_TIME",
          "INVALID_EVENT_TIME",
          "FUTURE_EVENT_TIME",
          "CONTRADICTORY_EPISODE",
          "ESTIMATED_ORIGIN",
          "ADJUSTED_ORIGIN",
          "UNKNOWN_ACQUISITION_SOURCE",
          "UNKNOWN_IDENTITY",
          "UNKNOWN_ROLE",
          "EFFECTIVE_CATALOGUE_UNAVAILABLE",
          "SOURCE_DIGEST_MISMATCH",
          "PROFILE_MISMATCH",
          "CONTENT_EXECUTION_MISMATCH",
          "TEXT_LIMIT",
          "JSON_LIMIT",
          "SQL_LIMIT",
          "TIME_LIMIT",
          "MEMORY_LIMIT",
          "OUTPUT_LIMIT",
          "COMPOSITE_NO_CREDIT_AGGREGATION",
          "NOT_REPRESENTED",
          "OUTSIDE_WINDOW",
          "SESSION_NOT_ELIGIBLE",
          "LEGACY_PROVENANCE_NOT_PERSISTED",
          "NO_DOCUMENTED_FACTS"
        ]
      },
      "uniqueItems": true
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "session_exercise_id",
        "set_log_id"
      ],
      "properties": {
        "session_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "session_exercise_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "set_log_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "until",
        "time_zone"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "until": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "time_zone": {
          "const": "UTC"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_sets",
        "secondary_sets",
        "minor_sets",
        "unknown_sets",
        "unknown_identity_sets",
        "execution_uncertain_sets",
        "resolved_credit",
        "bound",
        "policy_id",
        "exact_evidence",
        "scope"
      ],
      "properties": {
        "primary_sets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "secondary_sets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "minor_sets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "unknown_sets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "unknown_identity_sets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "execution_uncertain_sets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "resolved_credit": {
          "type": "number",
          "minimum": 0
        },
        "bound": {
          "type": "string",
          "enum": [
            "EXACT",
            "MINIMUM"
          ]
        },
        "policy_id": {
          "const": "sci-exposure-credit-v1"
        },
        "exact_evidence": {
          "type": "boolean"
        },
        "scope": {
          "const": "INSPECTED_ROLE_VECTOR"
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "documented_sets",
        "resolved_credit",
        "bound",
        "reasons"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "OBSERVED",
            "PARTIAL",
            "UNKNOWN",
            "EMPTY"
          ]
        },
        "documented_sets": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_credit": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "bound": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "EXACT",
                "MINIMUM"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        }
      }
    },
    "last": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "completed_at",
        "source_zone",
        "qualification"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$",
          "maxLength": 40
        },
        "source_zone": {
          "type": "string",
          "enum": [
            "pecs",
            "lats",
            "upper_back",
            "anterior_delts",
            "lateral_delts",
            "rear_delts",
            "biceps",
            "triceps",
            "quads",
            "hamstrings",
            "glutes",
            "adductors",
            "calves",
            "abs",
            "hip_flexors"
          ]
        },
        "qualification": {
          "const": "DOCUMENTARY_PROVENANCE_QUALIFIED"
        }
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone",
        "evidence",
        "window_result",
        "last_qualified_observation"
      ],
      "properties": {
        "zone": {
          "type": "string",
          "enum": [
            "pecs",
            "lats",
            "upper_back",
            "anterior_delts",
            "lateral_delts",
            "rear_delts",
            "biceps",
            "triceps",
            "quads",
            "hamstrings",
            "glutes",
            "adductors",
            "calves",
            "abs",
            "hip_flexors"
          ]
        },
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/evidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "window_result": {
          "$ref": "#/$defs/quantity"
        },
        "last_qualified_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/last"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bodymap_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bodymap_zone",
        "components",
        "window_result",
        "last_qualified_observation"
      ],
      "properties": {
        "bodymap_zone": {
          "type": "string",
          "enum": [
            "pecs",
            "lats",
            "upper_back",
            "delt_lat",
            "delt_post",
            "biceps",
            "triceps",
            "quads",
            "posterior",
            "calves",
            "core"
          ]
        },
        "components": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "string",
            "enum": [
              "pecs",
              "lats",
              "upper_back",
              "anterior_delts",
              "lateral_delts",
              "rear_delts",
              "biceps",
              "triceps",
              "quads",
              "hamstrings",
              "glutes",
              "adductors",
              "calves",
              "abs",
              "hip_flexors"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "window_result": {
          "$ref": "#/$defs/quantity"
        },
        "last_qualified_observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/last"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "bodymap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_version",
        "targets",
        "not_represented"
      ],
      "properties": {
        "mapping_version": {
          "const": "sci-p07-bodymap-projection/0.1.0"
        },
        "targets": {
          "type": "array",
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/bodymap_target"
          },
          "minItems": 11
        },
        "not_represented": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "anterior_delts",
              "adductors",
              "hip_flexors"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scan",
        "temporal",
        "mapping",
        "scope",
        "reasons"
      ],
      "properties": {
        "scan": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "TRUNCATED"
          ]
        },
        "temporal": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "mapping": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL"
          ]
        },
        "scope": {
          "const": "CURRENT_DOCUMENTED_ELIGIBLE_SUBSET_NOT_REAL_TRAINING_COMPLETENESS"
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions",
        "exercises",
        "work_sets",
        "operations",
        "graph_rows",
        "statements"
      ],
      "properties": {
        "sessions": {
          "const": 200
        },
        "exercises": {
          "const": 200
        },
        "work_sets": {
          "const": 500
        },
        "operations": {
          "const": 1000
        },
        "graph_rows": {
          "const": 500
        },
        "statements": {
          "const": 4096
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessions",
        "exercises",
        "work_sets",
        "operations",
        "graph_rows",
        "statements",
        "sentinels",
        "unvisited_frontiers",
        "db_input_bytes"
      ],
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "exercises": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        "work_sets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "operations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "graph_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500
        },
        "statements": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "sentinels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1801
        },
        "db_input_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2097152
        },
        "unvisited_frontiers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 901
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "limits",
        "usage",
        "truncated",
        "reasons"
      ],
      "properties": {
        "strategy": {
          "const": "OWNER_ID_ASC_NESTED"
        },
        "limits": {
          "$ref": "#/$defs/budgets"
        },
        "usage": {
          "$ref": "#/$defs/usage"
        },
        "truncated": {
          "type": "boolean"
        },
        "reasons": {
          "$ref": "#/$defs/reasons"
        }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "sha256"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalogue_version",
        "source_kind",
        "digest"
      ],
      "properties": {
        "catalogue_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "LEGACY_PINNED_READ_CLASSIFICATION",
            "V3_CAPTURED_EFFECTIVE_BUNDLE"
          ]
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "runtime_profile_digest",
        "result_digest",
        "source_digests"
      ],
      "properties": {
        "kind": {
          "const": "READ_TRANSACTION"
        },
        "runtime_profile_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "result_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_digests": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/pin"
          }
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "query",
        "step",
        "variant_key",
        "scientific_identity_id",
        "canonical_exercise_id",
        "catalogue_version",
        "reason"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "RESOLVED",
            "UNKNOWN_IDENTITY"
          ]
        },
        "query": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "step": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 3
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "scientific_identity_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_exercise_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "catalogue_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "SCAN_TRUNCATED",
                "GRAPH_TRUNCATED",
                "RECEIPT_CHAIN_TRUNCATED",
                "NULL_EVENT_TIME",
                "INVALID_EVENT_TIME",
                "FUTURE_EVENT_TIME",
                "CONTRADICTORY_EPISODE",
                "ESTIMATED_ORIGIN",
                "ADJUSTED_ORIGIN",
                "UNKNOWN_ACQUISITION_SOURCE",
                "UNKNOWN_IDENTITY",
                "UNKNOWN_ROLE",
                "EFFECTIVE_CATALOGUE_UNAVAILABLE",
                "SOURCE_DIGEST_MISMATCH",
                "PROFILE_MISMATCH",
                "CONTENT_EXECUTION_MISMATCH",
                "TEXT_LIMIT",
                "JSON_LIMIT",
                "SQL_LIMIT",
                "TIME_LIMIT",
                "MEMORY_LIMIT",
                "OUTPUT_LIMIT",
                "COMPOSITE_NO_CREDIT_AGGREGATION",
                "NOT_REPRESENTED",
                "OUTSIDE_WINDOW",
                "SESSION_NOT_ELIGIBLE",
                "LEGACY_PROVENANCE_NOT_PERSISTED",
                "NO_DOCUMENTED_FACTS"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zone",
        "raw_role",
        "role_basis",
        "evidence_refs",
        "execution_uncertain"
      ],
      "properties": {
        "zone": {
          "type": "string",
          "enum": [
            "pecs",
            "lats",
            "upper_back",
            "anterior_delts",
            "lateral_delts",
            "rear_delts",
            "biceps",
            "triceps",
            "quads",
            "hamstrings",
            "glutes",
            "adductors",
            "calves",
            "abs",
            "hip_flexors"
          ]
        },
        "raw_role": {
          "type": "string",
          "enum": [
            "PRIMARY",
            "SECONDARY",
            "MINOR",
            "UNKNOWN"
          ]
        },
        "role_basis": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "execution_uncertain": {
          "type": "boolean"
        }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_ref",
        "equipment_ref",
        "realization_ref",
        "side",
        "load_semantics"
      ],
      "properties": {
        "context_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "equipment_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "realization_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "side": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "load_semantics": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "expected_revision",
        "applied_revision",
        "body_digest",
        "recorded_at"
      ],
      "properties": {
        "op_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "applied_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        },
        "body_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recorded_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership",
        "status",
        "performed_at",
        "performed_at_estimated",
        "performed_at_adjusted",
        "reasons"
      ],
      "properties": {
        "membership": {
          "type": "string",
          "enum": [
            "IN_WINDOW",
            "UNKNOWN"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "DOCUMENTARY_PROVENANCE_QUALIFIED",
            "CANONICAL_DATE_PARTIAL_ORIGIN",
            "UNKNOWN_MEMBERSHIP",
            "FUTURE",
            "CONTRADICTORY_EPISODE"
          ]
        },
        "performed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "Z$",
              "maxLength": 40
            },
            {
              "type": "null"
            }
          ]
        },
