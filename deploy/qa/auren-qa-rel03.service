[Unit]
Description=AUREN isolated synthetic QA runtime
Requires=docker.service auren-qa-isolation.service
After=docker.service auren-qa-isolation.service
PartOf=docker.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /usr/local/libexec/auren-qa-isolation-v1
ExecStart=/usr/bin/docker start --attach auren-qa-rel03
ExecStop=/usr/bin/docker stop --time 20 auren-qa-rel03
Restart=on-failure
RestartSec=10
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
