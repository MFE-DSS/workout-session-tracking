# .env.production.example — template for the .env file deployed on the VPS.
#
# This file MUST NOT contain real secrets. The real .env lives on the VPS
# (typically /srv/workout/.env), is owned by the `workout` user, readable
# only by that user (chmod 600), and is loaded by:
#
#   - app/config.py via pydantic-settings at runtime
#   - deploy/workout.service via EnvironmentFile=/srv/workout/.env
#
# The systemd unit loads this file; do not `source` it in a shell.
# See docs/CICD_RUNBOOK.md §2 for the activation steps.

# -- Application --------------------------------------------------------
APP_ENV=production
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=REPLACE_ME_WITH_A_LONG_RANDOM_STRING
APP_BASE_URL=https://spignos.example.com
APP_HOST=127.0.0.1
APP_PORT=8000

# -- Database -----------------------------------------------------------
# SQLite path is absolute on the VPS, under the `workout` user's home /
# working directory (matches workout.service ReadWritePaths).
DATABASE_URL=sqlite:////srv/workout/var/workout.db

# -- Backups ------------------------------------------------------------
BACKUP_DIR=/srv/workout/var/backups
# 0 keeps backups forever; 30 is the project default.
BACKUP_RETENTION_DAYS=30

# -- SMTP (optional) ----------------------------------------------------
# Leave empty to disable outbound email (password resets, etc. will no-op).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
