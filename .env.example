# Copy to .env for local dev. All keys are read by app/config.py
APP_ENV=dev
APP_SECRET_KEY=change-me-in-production
APP_BASE_URL=http://localhost:8000

# SQLite in V1, switch to postgresql+psycopg://user:pwd@host/db for V2
DATABASE_URL=sqlite:///./var/workout.db

# Uvicorn bind (overridden by systemd unit on the VPS)
APP_HOST=127.0.0.1
APP_PORT=8000
