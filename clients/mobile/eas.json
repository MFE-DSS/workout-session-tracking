{
  "cli": {
    "version": ">= 25.1.1",
    "appVersionSource": "local"
  },
  "build": {
    "qa-android": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "AUREN_QA_BUILD": "1",
        "EXPO_PUBLIC_PLAN_V3_CONTROLLED_TEST": "1",
        "EXPO_PUBLIC_API_URL": "https://decorating-friendship-suggestions-current.trycloudflare.com"
      }
    },
    "pilot": {
      "distribution": "internal",
      "developmentClient": false,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://spignos.com"
      }
    }
  }
}
