{
  "$defs": {
    "ContextKey": {
      "additionalProperties": false,
      "properties": {
        "canonical_exercise_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Canonical Exercise Id"
        },
        "context_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Ref"
        },
        "equipment_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Equipment Ref"
        },
        "load_semantics": {
          "enum": [
            "TOTAL_EXTERNAL",
            "PER_IMPLEMENT",
            "MACHINE_DISPLAY_KG",
            "ASSISTANCE_SETTING",
            "NON_MASS_SETTING",
            "BODYWEIGHT",
            "UNKNOWN"
          ],
          "title": "Load Semantics",
          "type": "string"
        },
        "realization_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Realization Ref"
        },
        "side": {
          "enum": [
            "BILATERAL",
            "LEFT",
            "RIGHT",
            "UNKNOWN"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "canonical_exercise_id",
        "context_ref",
        "equipment_ref",
        "realization_ref",
        "load_semantics",
        "side"
      ],
      "title": "ContextKey",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "acquisition": {
          "enum": [
            "DECLARED",
            "SELF_MEASURED",
            "DEVICE_MEASURED",
            "EXECUTION_LOG",
            "DERIVED",
            "UNKNOWN"
          ],
          "title": "Acquisition",
          "type": "string"
        },
        "measured_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Measured At"
        },
        "origin": {
          "enum": [
            "USER_REPORTED",
            "USER_OBSERVED",
            "DERIVED_FROM_HISTORY",
            "POPULATION_PRIOR",
            "PRODUCT_CONTRACT",
            "UNKNOWN"
          ],
          "title": "Origin",
          "type": "string"
        },
        "recorded_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recorded At"
        },
        "source_ref": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Ref"
        }
      },
      "required": [
        "origin",
        "acquisition",
        "source_ref",
        "recorded_at",
        "measured_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Setting": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "MASS_KG",
            "ASSISTANCE_SETTING",
            "NON_MASS_SETTING",
            "BODYWEIGHT"
          ],
          "title": "Kind",
          "type": "string"
        },
        "unit": {
          "enum": [
            "kg",
            "setting",
            "none"
          ],
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "title": "Setting",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "available_in_effort_order": {
      "items": {
        "$ref": "#/$defs/Setting"
      },
      "title": "Available In Effort Order",
      "type": "array"
    },
    "chosen_setting": {
      "anyOf": [
        {
          "$ref": "#/$defs/Setting"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "$ref": "#/$defs/ContextKey"
    },
    "direction": {
      "enum": [
        "NONE",
        "RETAIN",
        "MORE_EFFORT",
        "LESS_EFFORT"
      ],
      "title": "Direction",
      "type": "string"
    },
    "observed_setting": {
      "$ref": "#/$defs/Setting"
    },
    "order_source": {
      "anyOf": [
        {
          "$ref": "#/$defs/Provenance"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "as_of",
    "context",
    "observed_setting",
    "chosen_setting",
    "available_in_effort_order",
    "order_source",
    "direction"
  ],
  "title": "SettingTransitionV3",
  "type": "object"
}
