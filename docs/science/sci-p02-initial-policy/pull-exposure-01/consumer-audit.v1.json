  "minimal_additive_artifact_design": {
    "status": "PROPOSED_FOR_SCIENTIFIC_REVIEW_ONLY",
    "inputs": "Pinned old curation/model/catalogue/schema/credit/E0/producer fixture hashes; exact canonical five IDs only.",
    "per_candidate_zone_fields": [
      "candidate_id",
      "zone",
      "source_role=UNKNOWN",
      "participation_state (unknown versus evidence-supported participation)",
      "separate functional_anatomy/acute_emg/biomechanics/longitudinal claims and refs",
      "execution qualification/unsupported assumptions",
      "ordinal_role=UNRESOLVED",
      "numeric_credit=UNRESOLVED (never 0 or 0.5)",
      "primary_intent_assessment",
      "reviewer_decision",
      "limitations"
    ],
    "vocabulary": "Use local fields/closed values in a dedicated versioned overlay; conceptual CONTRIBUTION_PRESENT_ROLE_UNRESOLVED is epistemic annotation, never a new canonical contributions[].role enum in this spike.",
    "resolver": "Optional isolated deterministic audit resolver validates exact candidate pool/source hashes and primary lats + vertical pattern + required execution/context predicates. It emits an unranked scientific result, separate from old-v1 exact-exposure admission. Blocking primary uncertainty, missing execution facts or unreviewed evidence fails closed. It must not call old eligibility validator with modified bundle or manufacture a trusted old fingerprint.",
    "output_invariants": [
      "runtime NOT_SERVED",
      "producer_binding null",
      "execution_ready false",
      "READY NOT_PRODUCED",
      "old_v1_catalog_gap preserved",
      "no selected/default/rank",
      "unknown rows retained",
      "no numeric ancillary credit",
      "no diagnosis/load/time inference",
      "no mobile/MISSION payload"
    ],
    "compatibility": "Keep curation1.0.0 byte-identical; keep catalogue/schema/E0 policy and producer1.0.0 pins and 11 outputs unchanged. New version owns only new assessments; existing consumers reject/ignore overlay unless explicitly bound later. Canonical E0 promotion is a separate coordinated review when shared hashes would change."
  },
